NODE_ENV=production
PORT=3000
DEFAULT_LANGUAGE=fr

# Client-facing URLs
DD_WEB_URL=https://app.dressdoctor.io
DD_API_URL=https://api.dressdoctor.io
DD_OFFICE_LINK_SECRET=change-me

# Database — external managed cluster, not containerized
DATABASE_URL=mongodb+srv://user:pass@prod-cluster.mongodb.net/dress-doctor

# Auth
SALT=change-me
JWT_SECRET=change-me-min-16-chars

# Seed / admin
ADMIN_PASSWORD=change-me
SEED_ITEMS=NO

# Platform client credentials (issued by the seed runner; do not hardcode)
API_KEY=
API_SECRET=

# Google Sheets migration (Phase 1 script only)
GOOGLE_APPLICATION_CREDENTIALS=

# Mail (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
MAIL_FROM=support@dressdoctor.io

# Redis — REDIS_HOST/REDIS_PORT are overridden by docker-compose.yml
# to point at the redis-prod container; only REDIS_NAME matters here.
REDIS_HOST=redis-prod
REDIS_PORT=6379
REDIS_NAME=prod

# WhatsApp Business Cloud API (send path not implemented yet)
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER=
