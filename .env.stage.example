NODE_ENV=production
PORT=3000
DEFAULT_LANGUAGE=fr

# Client-facing URLs
DD_WEB_URL=https://stage-app.dressdoctor.io
DD_API_URL=https://stage-api.dressdoctor.io
DD_OFFICE_LINK_SECRET=change-me

# Database — external managed cluster, not containerized
DATABASE_URL=mongodb+srv://user:pass@stage-cluster.mongodb.net/dress-doctor

# Auth
SALT=change-me
JWT_SECRET=change-me-min-16-chars

# Seed / admin
ADMIN_PASSWORD=change-me

# Platform client credentials (issued by the seed runner; do not hardcode)
API_KEY=
API_SECRET=

# Google Sheets migration (Phase 1 script only)

# Mail (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
MAIL_FROM=support@dressdoctor.io

# Redis — REDIS_HOST/REDIS_PORT are overridden by docker-compose.stage.yml
# to point at the redis-stage container; only REDIS_NAME matters here.
REDIS_HOST=redis-stage
REDIS_PORT=6379
REDIS_NAME=stage
# Logical Redis database. Real environments stay on 0; the e2e suites
# use their own db and wipe it around each run.
REDIS_DB=0

# How long the activity trail (who did what) is kept, in days. These rows name
# real people and real customers, so they expire rather than accumulating.
# Only read when the collection's TTL index is first built.
ACTIVITY_RETENTION_DAYS=730

# WhatsApp Business Cloud API (send path not implemented yet)
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER=
