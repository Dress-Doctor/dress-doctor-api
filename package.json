{
  "name": "dress-doctor-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker",
    "start:worker:dev": "ts-node -r tsconfig-paths/register src/worker.ts",
    "seed:test": "ts-node -r tsconfig-paths/register src/scripts/seed-test-data.ts",
    "backfill:payment-reference": "ts-node -r tsconfig-paths/register src/scripts/backfill-payment-reference.ts",
    "backfill:payment-period": "ts-node -r tsconfig-paths/register src/scripts/backfill-payment-period.ts",
    "backfill:payment-customer": "ts-node -r tsconfig-paths/register src/scripts/backfill-payment-customer.ts",
    "backfill:phone-e164": "ts-node -r tsconfig-paths/register src/scripts/backfill-phone-e164.ts",
    "backfill:user-type-reference": "ts-node -r tsconfig-paths/register src/scripts/backfill-user-type-reference.ts",
    "backfill:pickup-status-reference": "ts-node -r tsconfig-paths/register src/scripts/backfill-pickup-status-reference.ts",
    "backfill:order-status-reference": "ts-node -r tsconfig-paths/register src/scripts/backfill-order-status-reference.ts",
    "backfill:office-type-reference": "ts-node -r tsconfig-paths/register src/scripts/backfill-office-type-reference.ts",
    "backfill:payment-method-reference": "ts-node -r tsconfig-paths/register src/scripts/backfill-payment-method-reference.ts",
    "backfill:payment-type-reference": "ts-node -r tsconfig-paths/register src/scripts/backfill-payment-type-reference.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand --forceExit"
  },
  "dependencies": {
    "@casl/ability": "^6.7.5",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.3",
    "@types/cookie-parser": "^1.4.10",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.71.0",
    "chance": "^1.1.13",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "google-auth-library": "^10.5.0",
    "googleapis": "^171.4.0",
    "handlebars": "^4.7.8",
    "joi": "^18.2.3",
    "mongoose": "^9.1.2",
    "nestjs-i18n": "^10.6.0",
    "nodemailer": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/accept-language-parser": "^1.5.8",
    "@types/bcrypt": "^6.0.0",
    "@types/chance": "^1.1.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.11",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "src/api/payment/payment.service.ts": {
        "statements": 68,
        "branches": 62,
        "functions": 80,
        "lines": 68
      },
      "src/api/pricing/pricing.service.ts": {
        "statements": 60,
        "branches": 55,
        "functions": 58,
        "lines": 60
      },
      "src/api/order/order.service.ts": {
        "statements": 35,
        "branches": 42,
        "functions": 50,
        "lines": 35
      }
    }
  }
}
