NODE_ENV=development
PORT=3000
DEFAULT_LANGUAGE=fr

# Client-facing URLs
DD_WEB_URL=http://localhost:5173
DD_API_URL=http://localhost:3000
DD_OFFICE_LINK_SECRET=change-me
# Signed office-link validity (days); expiry is inside the HMAC payload
OFFICE_LINK_TTL_DAYS=365
# Attribution cookie domain (e.g. .dressdoctor.io in prod); empty → request host
COOKIE_DOMAIN=

# Database
DATABASE_URL=mongodb://localhost:27017/dress-doctor

# Auth
SALT=change-me
JWT_SECRET=change-me-min-16-chars
# Short-lived access token (jwt/ms duration string); refresh handles longevity
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Seed / admin
ADMIN_PASSWORD=change-me
SEED_ITEMS=NO

# Platform client credentials (issued by the seed runner; do not hardcode in prod)
API_KEY=
API_SECRET=

# Google Sheets migration (Phase 1 script only)
GOOGLE_APPLICATION_CREDENTIALS=

# Mail (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
MAIL_FROM=support@dressdoctor.io

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_NAME=dev

# WhatsApp Business Cloud API (send path not implemented yet)
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER=
