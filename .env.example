NODE_ENV=development
PORT=3000
DEFAULT_LANGUAGE=fr

# Client-facing URLs
DD_WEB_URL=http://localhost:5173
DD_API_URL=http://localhost:3000
DD_OFFICE_LINK_SECRET=change-me
# Signed office-link validity (days); expiry is inside the HMAC payload
OFFICE_LINK_TTL_DAYS=365
# Attribution cookie domain (e.g. .dressdoctor.io in prod); empty → request host
COOKIE_DOMAIN=

# Database
DATABASE_URL=mongodb://localhost:27017/dress-doctor

# Auth
SALT=change-me
JWT_SECRET=change-me-min-16-chars
# Short-lived access token (jwt/ms duration string); refresh handles longevity
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Seed / admin
ADMIN_PASSWORD=change-me

# Google Sheets migration (Phase 1 script only)

# Mail (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
MAIL_FROM=support@dressdoctor.io

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_NAME=dev
# Logical Redis database. Real environments stay on 0; the e2e suites
# use their own db and wipe it around each run.
REDIS_DB=0

# How long the activity trail (who did what) is kept, in days. These rows name
# real people and real customers, so they expire rather than accumulating.
# Only read when the collection's TTL index is first built.
ACTIVITY_RETENTION_DAYS=730

# WhatsApp Business Cloud API (send path not implemented yet)
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Customer Service WhatsApp destination for inactivity alerts (E.164)
CS_WHATSAPP_PHONE=
